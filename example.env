# Copy to .env and fill in. Every setting config.py reads is listed, in its
# order; a commented line shows the default the service uses when it is unset.
# The README's "Configuration" section says what each one is for.

# --- HTTP ---
# Requests with a larger body are refused (413) before parsing.
MAX_BODY_BYTES=65536

# --- earth chain ---
# cosmpy takes a scheme-prefixed URL. REST is the safer default: a node exposing
# only the API port is a supported deployment.
EARTH_NODE_URL=rest+https://lcd.erth.network
EARTH_CHAIN_ID=earth-1
EARTH_PREFIX=earth
EARTH_DENOM=uerth
EARTH_GAS_PRICE=0.025

# The hot key dust is sent from. Keep it topped up and keep it small — it is a
# hot key on a public endpoint, so treat its balance as the blast radius.
GAS_WALLET_MNEMONIC=twelve or twenty four words here

# What one /gas/register grant (a fee note) is worth, in uerth. Must cover one
# registration (6M gas at 0.005 uerth/gas).
DUST_UERTH=100000

# `earthd gas-check`: the binary (the image sets /opt/earthd/bin/earthd), a
# writable home, the CometBFT RPC it reads chain state from (also where the
# known-DSC set is read), and how long one check may take.
# EARTHD_BIN=earthd
# EARTHD_HOME=/tmp/earthd-home
# EARTH_RPC_URL=https://rpc.erth.network:443
# GAS_CHECK_TIMEOUT=60
# The backend's credential at Cloudflare for rpc./lcd.erth.network
# (services/edge.py; the deploy repo's akash/README.md, rule 0). Required by
# bin/build-sdl.py. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CHAIN_EDGE_TOKEN=
# CHAIN_EDGE_HOSTS=rpc.erth.network,lcd.erth.network
# One gas-check runs at a time; this many may wait (beyond: 503), of which
# GAS_CHECK_RESERVED_WAITING only for a new passport from a DSC the chain knows.
GAS_CHECK_MAX_WAITING=20
GAS_CHECK_RESERVED_WAITING=5
KNOWN_DSC_REFRESH_SECONDS=600

# personhood params (earth-1 genesis): where the passport proof's nullifier,
# binding, current_date, DSC commitment and identity commitment sit in
# public_signals, and the
# date skew allowed.
PASSPORT_NULLIFIER_INDEX=2
PASSPORT_ADDRESS_INDEX=1
PASSPORT_CURRENT_DATE_INDEX=0
PASSPORT_DSC_KEY_INDEX=3
PASSPORT_IDC_INDEX=4
PASSPORT_DATE_MAX_SKEW_SECONDS=172800

# Per-client limits on /gas/register. Trust CF-Connecting-IP only when
# Cloudflare is the sole ingress; locally (no Cloudflare) leave it false.
TRUST_CF_CONNECTING_IP=false
REGISTER_IP_MAX_PER_WINDOW=10
REGISTER_IP_WINDOW_SECONDS=3600
# A client is an IPv4 address or an IPv6 prefix of this many bits (48: one
# customer's whole delegation from a VPS host; 56 or 64 are looser).
REGISTER_IPV6_PREFIX=48
REGISTER_IP_MAX_TRACKED=20000
# Refusal budgets: gas-check refusals that cost a proof verification
# ("invalid registration proof" only), a minute, per DSC commitment, per
# issuing country and network-wide. Past one, a request under it needs a
# proof of work at POW_SHED_BITS (428 without). 0: that budget off.
REGISTER_REFUSALS_PER_DSC_PER_MINUTE=3
REGISTER_REFUSALS_PER_COUNTRY_PER_MINUTE=4
# At most what the lease can verify in a minute (~6 on 0.1 CPU), or it never trips.
REGISTER_REFUSALS_PER_MINUTE=5
# DSC and country budgets tracked at once, least recently touched evicted.
# REGISTER_REFUSAL_KEYS_TRACKED=10000
# Every gas-check refusal (not a daily cap) also counts against its client
# (an IPv4 address or IPv6 /REGISTER_CLIENT_REFUSAL_IPV6_PREFIX): this many in
# the window and its requests need a proof of work at POW_SHED_BITS (0: off).
REGISTER_CLIENT_REFUSALS_PER_WINDOW=3
REGISTER_CLIENT_REFUSAL_WINDOW_SECONDS=3600
REGISTER_CLIENT_REFUSAL_IPV6_PREFIX=64

# Proof of work (SHA-256 leading zero bits): the reserved lane, shedding,
# up to +POW_LOAD_EXTRA_BITS as the gas-check queue fills, capped.
POW_RESERVED_BITS=16
POW_SHED_BITS=20
POW_LOAD_EXTRA_BITS=2
POW_MAX_BITS=22
POW_MAX_AGE_SECONDS=600
# Used stamps remembered at once.
# POW_MAX_TRACKED=100000

# Rolling 24h caps on /gas/register grants: first registrations and switches.
REGISTER_GRANT_MAX_PER_DAY=500
REGISTER_SWITCH_GRANT_MAX_PER_DAY=100

# Seconds one request to the chain's REST endpoint may take, and how often
# /health's balance is read.
# CHAIN_HTTP_TIMEOUT=15
# HEALTH_REFRESH_SECONDS=30

# --- storage ---
# Replay protection and the grant history the caps count.
STATE_DB=ads_for_gas.db

# --- privacy indexer ---
# With GAS_ENABLED=false only the indexer and /privacy API run: no hot wallet.
GAS_ENABLED=true
INDEXER_ENABLED=false
INDEX_DB=privacy_index.db
# CometBFT RPC (needs /block_results) with block results kept from the start
# height on. rpc.erth.network is earth-1's one node, a full-history validator.
INDEXER_RPC_URL=https://rpc.erth.network:443
# INDEXER_RPC_TIMEOUT=20
# 0 = the node's earliest block. Only read while the index is empty.
INDEXER_START_HEIGHT=0
# Blocks a batch, block_results fetched at once, seconds between polls at the tip.
# INDEXER_BATCH=20
# INDEXER_CONCURRENCY=8
# INDEXER_POLL_SECONDS=2
# The handle directory: Handles query page size, re-read at least this often
# (block time), at most this many entries, at most once every
# HANDLES_MIN_REFRESH_BLOCKS, and flagged stale this many blocks behind.
# HANDLES_QUERY_LIMIT=1000
# HANDLES_MAX_AGE_SECONDS=3600
# HANDLES_MAX_ENTRIES=200000
# HANDLES_MIN_REFRESH_BLOCKS=10
# HANDLES_STALE_BLOCKS=30
# /privacy paging and admission (README "Paging rule"): page sizes wallets
# may ask for, responses in flight (503 past it), requests per client a window.
# PRIVACY_PAGE_DEFAULT=1000
PRIVACY_PAGE_SIZES=100,1000
PRIVACY_PAGE_MAX=1000
PRIVACY_MAX_CONCURRENT=4
PRIVACY_IP_MAX_PER_WINDOW=240
PRIVACY_IP_WINDOW_SECONDS=60
# CORS on /privacy for the web wallet: the one origin every response names
# (CDN-safe), plus local dev origins reflected uncached.
PRIVACY_CORS_ORIGIN=https://erth.network
PRIVACY_CORS_LOCALHOST=true

# --- deploy only, read by bin/ (not by the service) ---
# The backend's own Akash deployment, for bin/deploy.sh. NOT the chain node's.
DSEQ=
# Console API key. It can close the lease, which destroys the replay database.
AKASH_API_KEY=
# Injected into the submitted SDL for cloudflared. Anyone holding it can attach
# a replica to the tunnel.
TUNNEL_TOKEN=
