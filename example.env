# --- earth chain ---
# cosmpy takes a scheme-prefixed URL. REST is the safer default: a node exposing
# only the API port is a supported deployment.
EARTH_NODE_URL=rest+https://lcd.erth.network
EARTH_CHAIN_ID=earth-1
EARTH_PREFIX=earth
EARTH_DENOM=uerth
EARTH_GAS_PRICE=0.025

# The hot key dust is sent from. Keep it topped up and keep it small — it is a
# hot key on a public endpoint, so treat its balance as the blast radius.
GAS_WALLET_MNEMONIC=twelve or twenty four words here

# What a verified ad view is worth, in uerth. Must cover account creation plus
# one registration (~400k gas), with room for a few follow-ups.
DUST_UERTH=50000

# --- AdMob ---
# The rewarded ad unit allowed to trigger a grant.
ADMOB_AD_UNIT_ID=ca-app-pub-8662126294069074/9040854138,ca-app-pub-8662126294069074/1484036231

# --- storage ---
STATE_DB=ads_for_gas.db

# The backend's own Akash deployment, for bin/deploy.sh. NOT the chain node's.
DSEQ=

# --- deploy only, not read by the service ---
# Console API key. It can close the lease, which destroys the replay database.
AKASH_API_KEY=
# Injected into the submitted SDL for cloudflared. Anyone holding it can attach
# a replica to the tunnel.
TUNNEL_TOKEN=
