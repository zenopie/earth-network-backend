# --- earth chain ---
# cosmpy takes a scheme-prefixed URL. REST is the safer default: a node exposing
# only the API port is a supported deployment.
EARTH_NODE_URL=rest+https://lcd.erth.network
EARTH_CHAIN_ID=earth-1
EARTH_PREFIX=earth
EARTH_DENOM=uerth
EARTH_GAS_PRICE=0.025

# The hot key dust is sent from. Keep it topped up and keep it small — it is a
# hot key on a public endpoint, so treat its balance as the blast radius.
GAS_WALLET_MNEMONIC=twelve or twenty four words here

# What one /gas/register grant (a fee note) is worth, in uerth. Must cover one
# registration (6M gas at 0.005 uerth/gas).
DUST_UERTH=100000
# Rolling 24h cap on /gas/register payouts.
REGISTER_GRANT_MAX_PER_DAY=500
REGISTER_SWITCH_GRANT_MAX_PER_DAY=100
# Per-client limits on /gas/register. Trust CF-Connecting-IP only when
# Cloudflare is the sole ingress; locally (no Cloudflare) set it false.
TRUST_CF_CONNECTING_IP=false
REGISTER_IP_MAX_PER_WINDOW=10
REGISTER_IP_WINDOW_SECONDS=3600
# A client is an IPv4 address or an IPv6 prefix of this many bits (48: one
# customer's whole delegation from a VPS host; 56 or 64 are looser).
REGISTER_IPV6_PREFIX=48
REGISTER_IP_MAX_TRACKED=20000
# Refusal budgets: gas-check refusals that cost a proof verification
# ("invalid registration proof" only), a minute, per DSC commitment, per
# issuing country and network-wide. Past one, a request under it needs a
# proof of work at POW_SHED_BITS (428 without). 0: that budget off.
REGISTER_REFUSALS_PER_DSC_PER_MINUTE=3
REGISTER_REFUSALS_PER_COUNTRY_PER_MINUTE=10
REGISTER_REFUSALS_PER_MINUTE=30
# A DSC named by this many verification failures in the window leaves the
# reserved lane until they age out (0: off).
REGISTER_DSC_FAILURES_BEFORE_COOLDOWN=5
REGISTER_DSC_COOLDOWN_SECONDS=3600
# Proof of work (SHA-256 leading zero bits): the reserved lane, shedding,
# up to +POW_LOAD_EXTRA_BITS as the gas-check queue fills, capped.
POW_RESERVED_BITS=16
POW_SHED_BITS=20
POW_LOAD_EXTRA_BITS=2
POW_MAX_BITS=22
POW_MAX_AGE_SECONDS=600
# One gas-check runs at a time; this many may wait (beyond: 503), of which
# GAS_CHECK_RESERVED_WAITING only for a new passport from a DSC the chain knows.
GAS_CHECK_MAX_WAITING=20
GAS_CHECK_RESERVED_WAITING=5
KNOWN_DSC_REFRESH_SECONDS=600
# Requests with a larger body are refused (413) before parsing.
MAX_BODY_BYTES=65536
# personhood params (earth-1 genesis): where the passport proof's nullifier,
# binding and current_date sit in public_signals, and the date skew allowed.
PASSPORT_NULLIFIER_INDEX=2
PASSPORT_ADDRESS_INDEX=1
PASSPORT_CURRENT_DATE_INDEX=0
PASSPORT_DSC_KEY_INDEX=3
PASSPORT_DATE_MAX_SKEW_SECONDS=172800

# --- storage ---
STATE_DB=ads_for_gas.db

# --- privacy indexer ---
# GAS_ENABLED=false runs the indexer and /privacy API without a hot wallet.
GAS_ENABLED=true
INDEXER_ENABLED=false
INDEX_DB=privacy_index.db
# CometBFT RPC (needs /block_results) with block results kept from the start
# height on. rpc.erth.network is earth-1's one node, a full-history validator.
INDEXER_RPC_URL=https://rpc.erth.network:443
# 0 = the node's earliest block. Only read while the index is empty.
INDEXER_START_HEIGHT=0
# /privacy paging and admission (README "Paging rule"): page sizes wallets
# may ask for, responses in flight (503 past it), requests per client a window.
PRIVACY_PAGE_SIZES=100,1000
PRIVACY_PAGE_MAX=1000
PRIVACY_MAX_CONCURRENT=4
PRIVACY_IP_MAX_PER_WINDOW=240
PRIVACY_IP_WINDOW_SECONDS=60

# The backend's own Akash deployment, for bin/deploy.sh. NOT the chain node's.
DSEQ=

# --- deploy only, not read by the service ---
# Console API key. It can close the lease, which destroys the replay database.
AKASH_API_KEY=
# Injected into the submitted SDL for cloudflared. Anyone holding it can attach
# a replica to the tunnel.
TUNNEL_TOKEN=
